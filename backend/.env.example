# ===== إعدادات الباك إند =====
# انسخ الملف ده باسم .env واملأ القيم
#   cp .env.example .env

PORT=5000

# ===== قاعدة البيانات =====
# محلي: mongodb://127.0.0.1:27017/educommunity
# إنتاج (MongoDB Atlas): mongodb+srv://user:pass@cluster.mongodb.net/educommunity
MONGODB_URI=mongodb://127.0.0.1:27017/educommunity

# ===== التوكنات =====
# لازم يكونوا نصّين مختلفين وعشوائيين وطوال.
# ليه اتنين؟ عشان لو حد عرف سرّ الـ access مايقدرش يعمل refresh tokens بنفسه.
# accessToken  = 15 دقيقة (بيتبعت مع كل طلب)
# refreshToken = 7 أيام   (بيجيب access جديد بس)
JWT_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_DIFFERENT_long_random_string

# ===== Cloudinary (رفع الملفات على السحابة) =====
# سيبهم فاضيين في التطوير → المشروع هيستخدم التخزين المحلي في uploads/ تلقائياً.
# املأهم قبل النشر — لأن الملفات المحلية بتتمسح مع كل نشر على Render/Railway.
# تجيبهم من: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
